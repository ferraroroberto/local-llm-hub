{
  "_comment": [
    "Machine health watch thresholds (docs/health-watch.md). Re-read on every sample, so a retune needs no restart.",
    "Process rules: a value past watch_value/act_value, or steady growth past watch_rate_per_hour/act_rate_per_hour once the value is at least rate_min_value. null disables a limit.",
    "memory_mb has no absolute limit: a model server legitimately holds tens of GB; only steady growth is judged.",
    "System rules: watch/act limits; below=true means a low value is the bad one.",
    "Handles are file descriptors on macOS/Linux; commit and pool counters exist only on Windows.",
    "resource: the one-minute RAM / free-disk / per-disk latency watch with Telegram alerts (docs/health-watch.md). A sample is one minute, so sustain_samples is minutes. alert_below / alert_above_ms are the limits; min_ios is the fewest operations a window must complete to be judged for latency. alert.script null = ~/.claude/hooks/notify_send.py."
  ],
  "enabled": true,
  "interval_s": 600,
  "boot_delay_s": 15,
  "history_hours": 24,
  "stale_after_intervals": 3,
  "top_n": 15,
  "ignore_processes": [
    "System Idle Process"
  ],
  "reboot_only_processes": [
    "System",
    "Registry",
    "Memory Compression",
    "smss.exe",
    "csrss.exe",
    "wininit.exe",
    "services.exe",
    "lsass.exe"
  ],
  "attribution_share": 0.5,
  "leak": {
    "window_hours": 6,
    "min_samples": 4,
    "min_span_hours": 0.5,
    "min_rising_fraction": 0.6
  },
  "process": {
    "handles": {
      "watch_value": 300000,
      "act_value": 1000000,
      "watch_rate_per_hour": 5000,
      "act_rate_per_hour": 30000,
      "rate_min_value": 20000
    },
    "memory_mb": {
      "watch_value": null,
      "act_value": null,
      "watch_rate_per_hour": 300,
      "act_rate_per_hour": 2000,
      "rate_min_value": 1000
    },
    "gdi": {
      "watch_value": 5000,
      "act_value": 9000,
      "watch_rate_per_hour": 200,
      "act_rate_per_hour": 1000,
      "rate_min_value": 1000
    },
    "user": {
      "watch_value": 5000,
      "act_value": 9000,
      "watch_rate_per_hour": 200,
      "act_rate_per_hour": 1000,
      "rate_min_value": 1000
    },
    "threads": {
      "watch_value": 2000,
      "act_value": 5000,
      "watch_rate_per_hour": 100,
      "act_rate_per_hour": 500,
      "rate_min_value": 300
    }
  },
  "resource": {
    "enabled": true,
    "interval_s": 60,
    "boot_delay_s": 20,
    "stale_after_intervals": 3,
    "history_days": 14,
    "summary_days": 7,
    "min_coverage_percent": 50,
    "ram_free_percent": {
      "alert_below": 10,
      "sustain_samples": 3
    },
    "disk_free_gb": {
      "alert_below": 10,
      "sustain_samples": 3
    },
    "disk_latency": {
      "alert_above_ms": 500,
      "sustain_samples": 2,
      "min_ios": 5
    },
    "alert": {
      "enabled": true,
      "cooldown_hours": 6,
      "retry_after_s": 600,
      "category": "attention",
      "script": null,
      "timeout_s": 30
    }
  },
  "system": {
    "commit_percent": {
      "watch": 85,
      "act": 95
    },
    "ram_available_percent": {
      "watch": 10,
      "act": 5,
      "below": true
    },
    "nonpaged_pool_percent": {
      "watch": 6,
      "act": 10
    },
    "paged_pool_percent": {
      "watch": 15,
      "act": 25
    },
    "total_handles": {
      "watch": 2000000,
      "act": 4000000
    },
    "tcp_time_wait": {
      "watch": 4000,
      "act": 10000
    },
    "ephemeral_ports_percent": {
      "watch": 50,
      "act": 80
    },
    "disk_free_percent": {
      "watch": 15,
      "act": 5,
      "below": true
    }
  }
}
